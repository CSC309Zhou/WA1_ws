<?xml version="1.0"?>
<package format="3">
  <name>pico4_ros2</name>
  <version>0.1.0</version>
  <description>Robot independent ROS 2 adapter for the PICO4 XRoboToolkit PC SDK.</description>
  <maintainer email="wanglei@example.com">wanglei</maintainer>
  <license>Proprietary</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>dpkg</build_depend>
  <build_depend>libjsoncpp-dev</build_depend>
  <build_depend>pkg-config</build_depend>
  <build_depend>rosidl_default_generators</build_depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>ament_index_cpp</depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-numpy</test_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
