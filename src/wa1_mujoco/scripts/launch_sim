#!/usr/bin/env python3
"""Start the imported WA1 scene, optionally solving a TCP motion with official IK."""

import argparse
import json
import math

import mujoco
import mujoco.viewer

from wa1_mujoco.kinematics import (OfflineKinematics, joint_positions, load_home,
                                  pose_error, pose_in_base, set_joint_positions)


def main() -> int:
    parser = argparse.ArgumentParser(description='Offline WA1 MuJoCo scene')
    parser.add_argument('--headless', action='store_true', help='Run without a viewer')
    parser.add_argument('--seconds', type=float, default=2.0, help='Headless simulation length')
    parser.add_argument('--ik-demo', action='store_true',
                        help='Use official offline IK to move both TCPs 5 mm along BASE +X')
    args = parser.parse_args()
    if args.seconds <= 0:
        parser.error('--seconds must be positive')
    model, data = load_home()
    if args.ik_demo:
        kin = OfflineKinematics(model)
        left = [0.84, 0.49, 1.00, -1.96, 0.09, -0.08, 0.02]
        right = [0.84, -0.49, -1.00, -1.96, -0.09, -0.08, -0.02]
        names = [name for name in joint_positions(model, data)
                 if name.endswith('_L') or name.endswith('_R')]
        set_joint_positions(model, data, dict(zip(names, left + right)))
        reference = joint_positions(model, data)
        targets = {}
        for side in ('left', 'right'):
            target = pose_in_base(data, side)
            target[0] += 0.005
            solutions = kin.solve(target, side, reference)
            chosen = kin.nearest(solutions, reference)
            if chosen is None:
                raise RuntimeError(f'official IK has no {side} solution')
            for name, value in chosen['joints'].items():
                data.ctrl[model.actuator(name).id] = value
            targets[side] = target
        print('Offline official IK targets set for both TCP frames; endoscope_tcp is not an IK target.', flush=True)
    else:
        targets = {}
    if args.headless:
        for _ in range(round(args.seconds / model.opt.timestep)):
            mujoco.mj_step(model, data)
        if targets:
            result = {}
            for side, target in targets.items():
                position, rotation = pose_error(pose_in_base(data, side), target)
                result[side] = {'position_error_m': position, 'rotation_error_deg': rotation}
        else:
            result = {'state_finite': all(math.isfinite(v) for v in data.qpos)}
        print(json.dumps({'simulated_seconds': args.seconds, 'ik_demo': args.ik_demo,
                          'tcp_results': result}, indent=2))
    else:
        mujoco.viewer.launch(model, data)
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
