<?xml version="1.0"?>
<package format="3">
  <name>wa1_pico4_teleop</name>
  <version>0.1.0</version>
  <description>WA1 dual arm teleoperation using robot-independent PICO4 ROS 2 input.</description>
  <maintainer email="wanglei@example.com">wanglei</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>libjsoncpp-dev</build_depend>
  <build_depend>pkg-config</build_depend>
  <depend>rclcpp</depend>
  <depend>rcl_interfaces</depend>
  <depend>pico4_ros2</depend>
  <depend>upperlimb</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
