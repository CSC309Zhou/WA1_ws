<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="assembled_robot">
    <xacro:arg name="config" default="$(find wa1_description)/config/options.yaml"/>
    <xacro:arg name="robot_type" default="WA1-S"/>
    <xacro:arg name="include_builtin_left_hand" default="false"/>
    <xacro:arg name="include_builtin_right_hand" default="false"/>

    <xacro:property name="config_file" value="$(arg config)"/>
    <xacro:property name="robot_model_cfg" value="$(arg robot_type)"/>
    <xacro:property name="all_cfg" value="${xacro.load_yaml(config_file)}"/>
    <xacro:property name="robot_models" value="${[key for key in all_cfg.keys() if key != 'default_model']}"/>
    <xacro:property name="cfg" value="${all_cfg[robot_model_cfg] if robot_model_cfg in robot_models else xacro.fatal('Unsupported robot_model: %s. Supported robot_model values: %s' % (robot_model_cfg, ', '.join(robot_models)))}"/>

    <xacro:property name="front_lidar_mid360_enabled" value="${cfg['front_lidar_mid360']['enable'] if 'front_lidar_mid360' in cfg and 'enable' in cfg['front_lidar_mid360'] else False}"/>
    <xacro:property name="front_lidar_mid360_type" value="${cfg['front_lidar_mid360']['type'] if 'front_lidar_mid360' in cfg and 'type' in cfg['front_lidar_mid360'] else 'none'}"/>
    <xacro:property name="front_lidar_716mini_enabled" value="${cfg['front_lidar_716mini']['enable'] if 'front_lidar_716mini' in cfg and 'enable' in cfg['front_lidar_716mini'] else False}"/>
    <xacro:property name="front_lidar_716mini_type" value="${cfg['front_lidar_716mini']['type'] if 'front_lidar_716mini' in cfg and 'type' in cfg['front_lidar_716mini'] else 'none'}"/>
    <xacro:property name="back_lidar_enabled" value="${cfg['back_lidar']['enable'] if 'back_lidar' in cfg and 'enable' in cfg['back_lidar'] else False}"/>
    <xacro:property name="back_lidar_type" value="${cfg['back_lidar']['type'] if 'back_lidar' in cfg and 'type' in cfg['back_lidar'] else 'none'}"/>
    <xacro:property name="head_camera_enabled" value="${cfg['head_camera']['enable'] if 'head_camera' in cfg and 'enable' in cfg['head_camera'] else False}"/>
    <xacro:property name="head_camera_type" value="${cfg['head_camera']['type'] if 'head_camera' in cfg and 'type' in cfg['head_camera'] else 'none'}"/>
    <xacro:property name="chest_camera_enabled" value="${cfg['chest_camera']['enable'] if 'chest_camera' in cfg and 'enable' in cfg['chest_camera'] else False}"/>
    <xacro:property name="chest_camera_type" value="${cfg['chest_camera']['type'] if 'chest_camera' in cfg and 'type' in cfg['chest_camera'] else 'none'}"/>
    <xacro:property name="left_end_tool_enabled" value="${cfg['left_end_tool']['enable'] if 'left_end_tool' in cfg and 'enable' in cfg['left_end_tool'] else False}"/>
    <xacro:property name="left_end_tool_type" value="${cfg['left_end_tool']['type'] if 'left_end_tool' in cfg and 'type' in cfg['left_end_tool'] else 'none'}"/>
    <xacro:property name="right_end_tool_enabled" value="${cfg['right_end_tool']['enable'] if 'right_end_tool' in cfg and 'enable' in cfg['right_end_tool'] else False}"/>
    <xacro:property name="right_end_tool_type" value="${cfg['right_end_tool']['type'] if 'right_end_tool' in cfg and 'type' in cfg['right_end_tool'] else 'none'}"/>

    <xacro:include filename="$(find wa1_description)/urdf/WA1_400L.urdf.xacro"/>

    <xacro:include filename="$(find optional_description)/urdf/optional_description.xacro"/>
    <xacro:if value="${left_end_tool_enabled and left_end_tool_type == 'f5d6_p'}">
        <xacro:include filename="$(find f5d6_p_description)/urdf/D6_LEFT_HAND.urdf.xacro"/>
    </xacro:if>
    <xacro:if value="${right_end_tool_enabled and right_end_tool_type == 'f5d6_p'}">
        <xacro:include filename="$(find f5d6_p_description)/urdf/D6_RIGHT_HAND.urdf.xacro"/>
    </xacro:if>
    <xacro:if value="${left_end_tool_enabled and left_end_tool_type == 'f5d6_l'}">
        <xacro:include filename="$(find f5d6_l_description)/urdf/D6_L_LEFT_HAND.urdf.xacro"/>
    </xacro:if>
    <xacro:if value="${right_end_tool_enabled and right_end_tool_type == 'f5d6_l'}">
        <xacro:include filename="$(find f5d6_l_description)/urdf/D6_L_RIGHT_HAND.urdf.xacro"/>
    </xacro:if>
    <xacro:include filename="$(find wa1_description)/sensors/head_camera_d435i_d08.xacro"/>
    <xacro:include filename="$(find wa1_description)/sensors/head_camera_d435i_d11.xacro"/>
    <xacro:include filename="$(find wa1_description)/sensors/chest_camera_d435i.xacro"/>
    <xacro:include filename="$(find wa1_description)/sensors/front_lidar_mid360.xacro"/>
    <xacro:include filename="$(find wa1_description)/sensors/front_lidar_716mini.xacro"/>
    <xacro:include filename="$(find wa1_description)/sensors/back_lidar_716mini.xacro"/>

    <xacro:if value="${front_lidar_mid360_enabled and front_lidar_mid360_type == 'mid360'}">
        <xacro:front_lidar_mid360/>
    </xacro:if>

    <xacro:if value="${front_lidar_716mini_enabled and front_lidar_716mini_type == 'vanji_716mini'}">
        <xacro:front_lidar_716mini/>
    </xacro:if>

    <xacro:if value="${back_lidar_enabled and back_lidar_type == 'vanji_716mini'}">
        <xacro:back_lidar_716mini/>
    </xacro:if>

    <xacro:if value="${head_camera_enabled and head_camera_type == 'd435i_d08'}">
        <xacro:head_camera_d435i_d08/>
    </xacro:if>

    <xacro:if value="${head_camera_enabled and head_camera_type == 'd435i_d11'}">
        <xacro:head_camera_d435i_d11/>
    </xacro:if>

    <xacro:if value="${chest_camera_enabled and chest_camera_type == 'd435i'}">
        <xacro:chest_camera_d435i/>
    </xacro:if>

    <xacro:if value="${left_end_tool_enabled and (left_end_tool_type == 'f5d6_p' or left_end_tool_type == 'f5d6_l')}">
        <joint name="Hand_L" type="fixed">
            <origin xyz="0 0 0" rpy="-3.1416 0 3.1416"/>
            <parent link="TCP_L"/>
            <child link="HAND_L"/>
            <axis xyz="0 0 0"/>
        </joint>
    </xacro:if>

    <xacro:if value="${right_end_tool_enabled and (right_end_tool_type == 'f5d6_p' or right_end_tool_type == 'f5d6_l')}">
        <joint name="Hand_R" type="fixed">
            <origin xyz="0 0 0" rpy="3.1416 0 -3.1416"/>
            <parent link="TCP_R"/>
            <child link="HAND_R"/>
            <axis xyz="0 0 0"/>
        </joint>
    </xacro:if>
</robot>
