<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="front_lidar_mid360" params="parent:=BASE xyz:='0.38643 0 0.0078191' rpy:='0 0 0'">
        <xacro:mid360s parent="${parent}" prefix="front_lidar_mid360" xyz="${xyz}" rpy="${rpy}"/>
    </xacro:macro>
</robot>
